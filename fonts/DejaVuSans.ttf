ass="ͼe"># Header background</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_fill_color(</span><span class="ͼj">40</span><span>, </span><span class="ͼj">80</span><span>, </span><span class="ͼj">120</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>rect(</span><span class="ͼj">0</span><span>, </span><span class="ͼj">0</span><span>, </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>w, </span><span class="ͼj">30</span><span>, </span><span class="ͼk">"F"</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_text_color(</span><span class="ͼj">255</span><span>, </span><span class="ͼj">255</span><span>, </span><span class="ͼj">255</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">"B"</span><span>, </span><span class="ͼj">16</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_xy(</span><span class="ͼj">10</span><span>, </span><span class="ͼj">10</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼj">0</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"personal_info"</span><span>][</span><span class="ͼk">"name"</span><span>])</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">12</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_xy(</span><span class="ͼj">10</span><span>, </span><span class="ͼj">18</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ce