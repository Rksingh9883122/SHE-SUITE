from fpdf import FPDF
from docx import Document
import data  # Imports the data.py file
import os
import io
import textwrap
import json

# Title &amp; Picture
st.title("Raj Singh - Sr. HSE Manager")
if os.path.exists("profile.jpg"):
    st.image("profile.jpg", width=200)
else:
    st.warning("Profile picture not found. Please add 'profile.jpg' to the project folder.")

# Contact Info
st.write("📧 Raj.singh.hse@gmail.com")
st.write("📱 +91 9883122847")

# Skills
st.header("Skills")
for skill in data.skills:
    st.markdown(f"- {skill}")

# Achievements
st.header("Key Achievements")
for company, items in data.achievements.items():
    st.subheader(company)
    for item in items:
        st.write(f"✅ {item}")

# Education
st.header("Education")
for edu in data.education:
    st.write(f"🎓 {edu}")

# Certifications
st.header("Certifications")
for cert in data.certifications:
    st.markdown(f"- {cert}")

# Experience
st.header("Professional Experience")
for exp in data.experience:
    st.write(exp)

# -------------------------------
# PDF Export Function
# -------------------------------
def create_pdf():
    pdf = FPDF()
    pdf.add_page()
    pdf.set_auto_page_break(auto=True, margin=10)
    pdf.set_font("Arial", size=12)

    # Full usable width
    page_width = pdf.w - pdf.l_margin - pdf.r_margin

    # Title
    pdf.cell(page_width, 10, "Raj Singh - Sr. HSE Manager", ln=1, align="C")
    pdf.ln(5)

    pdf.cell(page_width, 10, "Contact: Raj.singh.hse@gmail.com | +91 9883122847", ln=1)
    pdf.ln(5)

    # Skills
    pdf.cell(page_width, 10, "Skills:", ln=1)
    for skill in data.skills:
        pdf.set_x(pdf.l_margin)
        wrapped = "\n".join(textwrap.wrap(skill, 80))
        pdf.multi_cell(page_width, 8, f"- {wrapped}")
    pdf.ln(3)

    # Achievements
    pdf.set_x(pdf.l_margin)
    pdf.cell(page_width, 10, "Achievements:", ln=1)

    for company, items in data.achievements.items():
        pdf.set_x(pdf.l_margin)  # ✅ FIX
        pdf.cell(page_width, 8, company, ln=1)

    for item in items:
        pdf.set_x(pdf.l_margin)  # ✅ FIX (CRITICAL)
        wrapped = "\n".join(textwrap.wrap(item, 80))
        pdf.multi_cell(page_width, 8, f"- {wrapped}")

    # Education
    pdf.set_x(pdf.l_margin)
    pdf.cell(page_width, 10, "Education:", ln=1)
    for edu in data.education:
        pdf.set_x(pdf.l_margin)
        wrapped = "\n".join(textwrap.wrap(edu, 80))
        pdf.multi_cell(page_width, 8, f"- {wrapped}")
    pdf.ln(3)

    # Certifications
    pdf.cell(page_width, 10, "Certifications:", ln=1)
    for cert in data.certifications:
        pdf.set_x(pdf.l_margin)
        wrapped = "\n".join(textwrap.wrap(cert, 80))
        pdf.multi_cell(page_width, 8, f"- {wrapped}")
    pdf.ln(3)

    # Experience
    pdf.cell(page_width, 10, "Experience:", ln=1)
    for exp in data.experience:
        exp_clean = exp.replace("**", "")
        pdf.set_x(pdf.l_margin)
        wrapped = "\n".join(textwrap.wrap(exp_clean, 90))
        pdf.multi_cell(page_width, 8, wrapped)

    # Output handling
    try:
        pdf_out = pdf.output()
    except TypeError:
        pdf_out = pdf.output(dest="S")

    if isinstance(pdf_out, str):
        return pdf_out.encode('latin-1')
    else:
        return bytes(pdf_out)
# -------------------------------
# Word Export Function
# -------------------------------
def create_word():
    doc = Document()
    doc.add_heading("Raj Singh - Sr. HSE Manager", level=0)
    doc.add_paragraph("Contact: Raj.singh.hse@gmail.com | +91 9883122847")
    
    doc.add_heading("Skills", level=1)
    for skill in data.skills:
        doc.add_paragraph(f"- {skill}")
        
    doc.add_heading("Achievements", level=1)
    for company, items in data.achievements.items():
        doc.add_heading(company, level=2)
        for item in items:
            doc.add_paragraph(f"✅ {item}")
            
    doc.add_heading("Education", level=1)
    for edu in data.education:
        doc.add_paragraph(f"🎓 {edu}")
        
    doc.add_heading("Certifications", level=1)
    for cert in data.certifications:
        doc.add_paragraph(f"- {cert}")
        
    doc.add_heading("Experience", level=1)
    for exp in data.experience:
        # Strip markdown bold formatting for the Word export
        exp_clean = exp.replace("**", "")
        doc.add_paragraph(exp_clean)
        
    # Save the document to a byte stream to avoid file locking issues
    bio = io.BytesIO()
    doc.save(bio)
    return bio.getvalue()

# -------------------------------
# Download Buttons
# -------------------------------
st.write("---")

# PDF Download
pdf_data = create_pdf()
st.download_button(
    label="📄 Download Profile as PDF", 
    data=pdf_data, 
    file_name="Raj_Singh_Profile.pdf", 
    mime="application/pdf"
)

# Word Download
word_data = create_word()
st.download_button(
    label="📝 Download Profile as Word", 
    data=word_data, 
    file_name="Raj_Singh_Profile.docx", 
    mime="application/vnd.openxmlformats-officedocument.wordprocessingml.document"
