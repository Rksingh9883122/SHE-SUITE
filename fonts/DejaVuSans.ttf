an><span class="ͼg">in</span><span> </span><span class="ͼm">exp</span><span>[</span><span class="ͼk">"details"</span><span>]:</span><br><span>            </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_x(</span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>l_margin)</span><br><span>            </span><span class="ͼm">wrapped</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">"</span><span class="ͼq">\n</span><span class="ͼk">"</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">textwrap</span><span class="ͼg">.</span><span>wrap(</span><span class="ͼm">detail</span><span>, </span><span class="ͼj">95</span><span>))</span><br><span>            </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"– </span><span>{</span><span class="ͼm">wrapped</span><span>}</span><span class="ͼk">"</span><span>)</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">1</span><span>)</span><br><br><span>    </span><span class="ͼe"># ===== EDUCATION =====</span><br><span>    </span><span class="ͼm">section</span><span>(</span><span class="ͼk">"Education"</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">edu</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span class="ͼg">.</span><span>education:</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"• </span><span>{</span><span class="ͼm">edu</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">2</span><span>)</span><br><br><span>    </span><span class="ͼe"># ===== CERTIFICATIONS =====</span><br><span>    </span><span class="ͼm">section</span><span>(</span><span class="ͼk">"Certifications"</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">cert</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span class="ͼg">.</span><span>certifications:</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"• </span><span>{</span><span class="ͼm">cert</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="ͼe"># Output</span><br><span>    </span><span class="ͼg">try</span><span>:</span><br><span>        </span><span class="ͼm">pdf_out</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>output()</span><br><span>    </span><span class="ͼg">except</span><span> </span><span class="ͼm">TypeError</span><span>:</span><br><span>        </span><span class="ͼm">pdf_out</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>output(</span><span class="ͼm">dest</span><span class="ͼg">=</span><span class="ͼk">"S"</span><span>)</span><br><br><span>    </span><span class="ͼg">return</span><span> </span><span class="ͼm">pdf_out</span><span class="ͼg">.</span><span>encode(</span><span class="ͼk">'latin-1'</span><span>) </span><span class="ͼg">if</span><span> </span><span class="ͼm">isinstance</span><span>(</span><span class="ͼm">pdf_out</span><span>, </span><span class="ͼm">str</span>