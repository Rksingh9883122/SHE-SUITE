n><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_text_color(</span><span class="ͼj">0</span><span>, </span><span class="ͼj">0</span><span>, </span><span class="ͼj">0</span><span>)</span><br><br><span>    </span><span class="ͼe"># ===== SKILLS =====</span><br><span>    </span><span class="ͼm">section</span><span>(</span><span class="ͼk">"Skills"</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">skill</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span class="ͼg">.</span><span>skills:</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_x(</span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>l_margin)</span><br><span>        </span><span class="ͼm">wrapped</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">"</span><span class="ͼq">\n</span><span class="ͼk">"</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">textwrap</span><span class="ͼg">.</span><span>wrap(</span><span class="ͼm">skill</span><span>, </span><span class="ͼj">90</span><span>))</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"• </span><span>{</span><span class="ͼm">wrapped</span><span>}</span><span class="ͼk">"</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">2</span><span>)</span><br><br><span>    </span><span class="ͼe"># ===== ACHIEVEMENT