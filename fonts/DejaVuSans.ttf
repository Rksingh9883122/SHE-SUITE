 class="ͼe"># Name centered</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">"B"</span><span>, </span><span class="ͼj">18</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">10</span><span>, </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"personal_info"</span><span>][</span><span class="ͼk">"name"</span><span>], </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>, </span><span class="ͼm">align</span><span class="ͼg">=</span><span class="ͼk">"C"</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">12</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"personal_info"</span><span>][</span><span class="ͼk">"title"</span><span>], </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>, </span><span class="ͼm">align</span><span class="ͼg">=</span><span class="ͼk">"C"</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">5</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"</span><span>{</span><span class="ͼm">data</span><span>[</span><span class="ͼk">'personal_info'</span><span>][</span><span class="ͼk">'email'</span><span>]}</span><span class="ͼk"> | </span><span>{</span><span class="ͼm">data</span><span>[</span><span class="ͼk">'personal_info'</span><span>][</span><span class="ͼk">'phone'</span><span>]}</span><span class="ͼk">"</span><span>, </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>, </span><span class="ͼm">align</span><span class="ͼg">=</span><span class="ͼk">"C"</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">8</span><span>)</span><br><br><span>    </span><span class="ͼg">def</span><span> </span><span class="ͼm">section</span><span>(</span><span class="ͼm">title</span><span>):</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">"B"</span><span>, </span><span class="ͼj">12</span><span>)</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼm">title</span><span>, </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>line(</span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>l_margin, </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>get_y(), </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>w </span><span class="ͼg">-</span><span> </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>r_margin, </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>get_y())</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">2</span><span>)</span><br><br><span>    </span><span class="ͼe"># Skills</span><br><span>    </span><span class="ͼm">section</span><span>(</span><span class="ͼk">"Skills"</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">", "</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">data</span><span>[</span><span class="ͼk">"skills"</span><span>]))</span><br><br><span>    </span><span class="ͼe"># Experience</span><br><span>    </span><span class="ͼm">section</span><span>(</span><span class="ͼk">"Experience"</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">exp</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"experience"</span><span>]:</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">"B"</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"</span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'company'</span><span>]}</span><span class="ͼk"> | </span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'role'</span><span>]}</span><span class="ͼk">"</span><span>, </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>        </span><span class="ͼg">for</span><span> </span><span class="ͼm">proj</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">exp</span><span>[</span><span class="ͼk">"projects"</span><span>]:</span><br><span>            </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼm">proj</span><span>[</span><span class="ͼk">"name"</span><span>], </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><span>            </span><span class="ͼg">for</span><span> </span><span class="ͼm">d</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">proj</span><span>[</span><span class="ͼk">"details"</span><span>]:</span><br><span>                </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">w</span><span>, </span><span class="ͼj">6</span><span>, </span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">d</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="ͼg">return</span><span> </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>output(</span><span class="ͼm">dest</span><span class="ͼg">=</span><span class="ͼk">"S"</span><span>)</span><span class="ͼg">.</span><span>encode(</span><span class="ͼk">"latin-1"</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
