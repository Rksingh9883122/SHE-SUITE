<pre class="overflow-visible! px-0!" data-start="5341" data-end="5685"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-6d2147a0.svg#e45ab3" fill="currentColor"></use></svg>Python</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-6d2147a0.svg#ce3544" fill="currentColor"></use></svg></button><button class="btn relative group-focus-within/dialog:focus-visible:[outline-width:1.5px] group-focus-within/dialog:focus-visible:[outline-offset:2.5px] group-focus-within/dialog:focus-visible:[outline-style:solid] group-focus-within/dialog:focus-visible:[outline-color:var(--text-primary)] btn-ghost border-token-border-default ms-2 border font-sans" aria-label="Run code" type="button"><div class="flex w-full items-center justify-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-label="" class="-ms-0.5 icon"><use href="/cdn/assets/sprites-core-6d2147a0.svg#6ef7a4" fill="currentColor"></use></svg>Run</div></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="relative"><div class="" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span class="ͼm">st</span><span class="ͼg">.</span><span>title(</span><span class="ͼm">data</span><span>[</span><span class="ͼk">"personal_info"</span><span>][</span><span class="ͼk">"name"</span><span>])</span><br><br><span class="ͼg">for</span><span> </span><span class="ͼm">exp</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"experience"</span><span>]:</span><br><span>    </span><span class="ͼg">with</span><span> </span><span class="ͼm">st</span><span class="ͼg">.</span><span>expander(</span><span class="ͼk">f"</span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'company'</span><span>]}</span><span class="ͼk"> - </span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'role'</span><span>]}</span><span class="ͼk">"</span><span>):</span><br><span>        </span><span class="ͼg">for</span><span> </span><span class="ͼm">project</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">exp</span><span>[</span><span class="ͼk">"projects"</span><span>]:</span><br><span>            </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"**</span><span>{</span><span class="ͼm">project</span><span>[</span><span class="ͼk">'name'</span><span>]}</span><span class="ͼk"> (</span><span>{</span><span class="ͼm">project</span><span class="ͼg">.</span><span>get(</span><span class="ͼk">'location'</span><span>,</span><span class="ͼk">''</span><span>)}</span><span class="ͼk">)**"</span><span>)</span><br><span>            </span><span class="ͼg">for</span><span> </span><span class="ͼm">d</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">project</span><span>[</span><span class="ͼk">"details"</span><span>]:</span><br><span>                </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">d</span><span>}</span><span class="ͼk">"</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
