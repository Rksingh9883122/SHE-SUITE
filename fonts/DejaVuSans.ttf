</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼm">exp_clean</span><span>)</span><br><br><span>    </span><span class="ͼe"># Output handling</span><br><span>    </span><span class="ͼg">try</span><span>:</span><br><span>        </span><span class="ͼm">pdf_out</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>output()</span><br><span>    </span><span class="ͼg">except</span><span> </span><span class="ͼm">TypeError</span><span>:</span><br><span>        </span><span class="ͼm">pdf_out</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>output(</span><span class="ͼm">dest</span><span class="ͼg">=</span><span class="ͼk">"S"</span><span>)</span><br><br><span>    </span><span class="ͼg">if</span><span> </span><span class="ͼm">isinstance</span><span>(</span><span class="ͼm">pdf_out</span><span>, </span><span class="ͼm">str</span><span>):</span><br><span>        </span><span class="ͼg">return</span><span> </span><span class="ͼm">pdf_out</span><span class="ͼg">.</span><span>encode(</span><span class="ͼk">'latin-1'</span><span>)</span><br><span>    </span><span class="ͼg">else</span><span>:</span><br><span>        </span><span class="ͼg">return</span><span> </span><span class="ͼm">bytes</span><span>(</span><span class="ͼm">pdf_out</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<hr data-start="2160" data-end="2163">
<h2 data-section-id="tte5o3" data-start="2165" data-end="2196">🧠 Why this fixes your error</h2>
<h3 data-section-id="1ktc77i" data-start="2198" data-end="2214">✔ Key fixes:</h3>
<ul data-start="2215" data-end="2370">
<li data-section-id="1gc1iga" data-start="2215" data-end="2267">
<p data-start="2217" data-end="2267"><code data-start="2217" data-end="2267">page_width = pdf.w - pdf.l_margin - pdf.r_margin</code></p>
</li>
<li data-section-id="1o588ba" data-start="2268" data-end="2314">
<p data-start="2270" data-end="2314">Always using <strong data-start="2283" data-end="2314">explicit width instead of 0</strong></p>
</li>
<li data-section-id="rncfas" data-start="2315" data-end="2370">
<p data-start="2317" data-end="2370"><code data-start="2317" data-end="2342">pdf.set_x(pdf.l_margin)</code> before every <code data-start="2356" data-end="2370">multi_cell()</code></p>
</li>
</ul>
<hr data-start="2372" data-end="2375">
<h2 data-section-id="131luke" data-start="2377" data-end="2427">⚠️ Bonus improvement (optional but recommended)</h2>
<p data-start="2429" data-end="2456">If your data ever contains:</p>
<ul data-start="2457" data-end="2500">
<li data-section-id="ynmk0q" data-start="2457" data-end="2470">
<p data-start="2459" data-end="2470">long URLs</p>
</li>
<li data-section-id="16lropw" data-start="2471" data-end="2500">
<p data-start="2473" data-end="2500">long words without spaces</p>
</li>
</ul>
<p data-start="2502" data-end="2524">Add this inside loops:</p>
<pre class="overflow-visible! px-0!" data-start="2526" data-end="2647"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="sticky z-2 select-none top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-token-bg-elevated-secondary"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-6d2147a0.svg#e45ab3" fill="currentColor"></use></svg>Python</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-6d2147a0.svg#ce3544" fill="currentColor"></use></svg></button><button class="btn relative group-focus-within/dialog:focus-visible:[outline-width:1.5px] group-focus-within/dialog:focus-visible:[outline-offset:2.5px] group-focus-within/dialog:focus-visible:[outline-style:solid] group-focus-within/dialog:focus-visible:[outline-color:var(--text-primary)] btn-ghost border-token-border-default ms-2 border font-sans" aria-label="Run code" type="button"><div class="flex w-full items-center justify-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-label="" class="-ms-0.5 icon"><use href="/cdn/assets/sprites-core-6d2147a0.svg#6ef7a4" fill="currentColor"></use></svg>Run</div></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="relative"><div class="" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span class="ͼg">import</span><span> </span><span class="ͼm">textwrap</span><br><span class="ͼm">wrapped</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">"</span><span class="ͼq">\n</span><span class="ͼk">"</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">textwrap</span><span class="ͼg">.</span><span>wrap(</span><span class="ͼm">skill</span><span>, </span><span class="ͼj">80</span><span>))</span><br><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">wrapped</span><span>}</span><span class="ͼk">"</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
