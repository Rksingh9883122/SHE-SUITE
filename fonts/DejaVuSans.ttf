lti_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼm">wrapped</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
