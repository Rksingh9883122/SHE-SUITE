-------</span><br><span class="ͼm">st</span><span class="ͼg">.</span><span>header(</span><span class="ͼk">"Key Achievements"</span><span>)</span><br><span class="ͼg">for</span><span> </span><span class="ͼm">company</span><span>, </span><span class="ͼm">items</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span class="ͼg">.</span><span>achievements</span><span class="ͼg">.</span><span>items():</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>subheader(</span><span class="ͼm">company</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">item</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">items</span><span>:</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>write(</span><span class="ͼk">f"✅ </span><span>{</span><span class="ͼm">item</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span class="ͼe"># -------------------------------</span><br><span class="ͼe"># Education</span><br><span class="ͼe"># -------------------------------</span><br><span class="ͼm">st</span><span class="ͼg">.</span><span>header(</span><span class="ͼk">"Education"</span><span>)</span><br><span class="ͼg">for</span><span> </span><span class="ͼm">edu</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span class="ͼg">.</span><span>education:</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>write(</span><span class="ͼk">f"🎓 </span><span>{</span><span class="ͼm">edu</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span class="ͼe"># -------------------------------</span><br><span class="ͼe"># Certifications</span><br><span class="ͼe"># -------------------------------</span><br><span class="ͼm">st</span><span class="ͼg">.</span><span>header(</span><span class="ͼk">"Certifications"</span><span>)</span><br><span