Vu"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼk">"Contact: Raj.singh.hse@gmail.com | +91 9883122847"</span><span>, </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>ln(</span><span class="ͼj">4</span><span>)</span><br><br><span>    </span><span class="ͼe"># Skills</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"DejaVu"</span><span>, </span><span class="ͼk">"B"</span><span>, </span><span class="ͼj">12</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼk">"Skills:"</span><span>, </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"DejaVu"</span><span>, </span><span class="ͼk">""</span><span>, </span><span class="ͼj">11</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">skill</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span class="ͼg">.</span><span>skills:</span><br><span>        </span><span class="ͼm">wrapped</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">"</span><span class="ͼq">\n</span><span class="ͼk">"</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">textwrap</span><span class="ͼg">.</span><span>wrap(</span><span class="ͼm">skill</span><span>, </span><span class="ͼj