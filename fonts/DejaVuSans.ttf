m">exp_detail</span><span>:</span><br><span>            </span><span class="ͼm">comp</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">next</span><span>((</span><span class="ͼm">e</span><span> </span><span class="ͼg">for</span><span> </span><span class="ͼm">e</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"experience"</span><span>] </span><span class="ͼg">if</span><span> </span><span class="ͼm">e</span><span>[</span><span class="ͼk">"company"</span><span>] </span><span class="ͼg">==</span><span> </span><span class="ͼm">exp_company</span><span>), </span><span class="ͼj">None</span><span>)</span><br><br><span>            </span><span class="ͼg">if</span><span> </span><span class="ͼg">not</span><span> </span><span class="ͼm">comp</span><span>:</span><br><span>                </span><span class="ͼm">comp</span><span> </span><span class="ͼg">=</span><span> {</span><span class="ͼk">"company"</span><span>: </span><span class="ͼm">exp_company</span><span>, </span><span class="ͼk">"role"</span><span>: </span><span class="ͼm">exp_role</span><span>, </span><span class="ͼk">"projects"</span><span>: []}</span><br><span>                </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"experience"</span><span>]</span><span class="ͼg">.</span><span>append(</span><span class="ͼm">comp</span><span>)</span><br><br><span>            </span><span class="ͼm">proj</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">next</span><span>((</span><span class="ͼm">p</span><span> </span><span class="ͼg">for</span><span> </span><span class="ͼm">p</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">comp</span><span>[</span><span class="ͼk">"projects"</span><span>] </span><span class="ͼg">if</span><span> </span><span class="ͼm">p</span><span>[</span><span class="ͼk">"name"</span><span>] </span><span class="ͼg">==</span><span> </span><span class="ͼm">exp_project</span><span>), </span><span class="ͼj">None</span><span>)</span><br><br><span>            </span><span class="ͼg">if</span><span> </span><span class="ͼg">not</span><span> </span><span class="ͼm">proj</span><span>:</span><br><span>                </span><span class="ͼm">proj</span><span> </span><span class="ͼg">=</span><span> {</span><span class="ͼk">"name"</span><span>: </span><span class="ͼm">exp_project</span><span>, </span><span class="ͼk">"details"</span><span>: []}</span><br><span>                </span><span class="ͼm">comp</span><span>[</span><span class="ͼk">"projects"</span><span>]</span><span class="ͼg">.</span><span>append(</span><span class="ͼm">proj</span><span>)</span><br><br><span>            </span><span class="ͼm">proj</span><span>[</span><span class="ͼk">"details"</span><span>]</span><span class="ͼg">.</span><span>append(</span><span class="ͼm">exp_detail</span><span>)</span><br><br><span>    </span><span class="ͼe"># -------- Save / Load --------</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>subheader(</span><span class="ͼk">"Data"</span><span>)</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>download_button(</span><span class="ͼk">"📥 Download JSON"</span><span>, </span><span class="ͼm">json</span><span class="ͼg">.</span><span>dumps(</span><span class="ͼm">data</span><span>, </span><span class="ͼm">indent</span><span class="ͼg">=</span><span class="ͼj">2</span><span>), </span><span class="ͼk">"resume.json"</span><span>)</span><br><br><span>    </span><span class="ͼm">uploaded</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">st</span><span class="ͼg">.</span><span>file_uploader(</span><span class="ͼk">"Load JSON"</span><span>, </span><span class="ͼm">type</span><span class="ͼg">=</span><span class="ͼk">"json"</span><span>)</span><br><span>    </span><span class="ͼg">if</span><span> </span><span class="ͼm">uploaded</span><span>:</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>session_state</span><span class="ͼg">.</span><span>resume </span><span class="ͼg">=</span><span> </span><span class="ͼm">json</span><span class="ͼg">.</span><span>load(</span><span class="ͼm">uploaded</span><span>)</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>success(</span><span class="ͼk">"Loaded successfully"</span><span>)</span><br><br><span>    </span><span class="ͼe"># -------- PDF --------</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>subheader(</span><span class="ͼk">"Export"</span><span>)</span><br><span>    </span><span class="ͼm">pdf_data</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">generate_pdf</span><span>(</span><span class="ͼm">data</span><span>)</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>download_button(</span><span class="ͼk">"📄 Download PDF"</span><span>, </span><span class="ͼm">pdf_data</span><span>, </span><span class="ͼk">"resume.pdf"</span><span>)</span><br><br><br><span class="ͼe"># ===============================</span><br><span class="ͼe"># 👀 RIGHT: LIVE PREVIEW</span><br><span class="ͼe"># ===============================</span><br><span class="ͼg">with</span><span> </span><span class="ͼm">col2</span><span>:</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>title(</span><span class="ͼk">"📄 Live Preview"</span><span>)</span><br><br><span>    </span><span class="ͼm">info</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"personal_info"</span><span>]</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"## </span><span>{</span><span class="ͼm">info</span><span>[</span><span class="ͼk">'name'</span><span>]}</span><span class="ͼk">"</span><span>)</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>write(</span><span class="ͼm">info</span><span>[</span><span class="ͼk">"title"</span><span>])</span><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>write(</span><span class="ͼk">f"</span><span>{</span><span class="ͼm">info</span><span>[</span><span class="ͼk">'email'</span><span>]}</span><span class="ͼk"> | </span><span>{</span><span class="ͼm">info</span><span>[</span><span class="ͼk">'phone'</span><span>]}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="ͼg">if</span><span> </span><span class="ͼk">"profile_image"</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">st</span><span class="ͼg">.</span><span>session_state:</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>image(</span><span class="ͼm">st</span><span class="ͼg">.</span><span>session_state[</span><span class="ͼk">"profile_image"</span><span>], </span><span class="ͼm">width</span><span class="ͼg">=</span><span class="ͼj">150</span><span>)</span><br><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>subheader(</span><span class="ͼk">"Skills"</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">s</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"skills"</span><span>]:</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">s</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>subheader(</span><span class="ͼk">"Achievements"</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">a</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"achievements"</span><span>]:</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"**</span><span>{</span><span class="ͼm">a</span><span>[</span><span class="ͼk">'company'</span><span>]}</span><span class="ͼk">**"</span><span>)</span><br><span>        </span><span class="ͼg">for</span><span> </span><span class="ͼm">i</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">a</span><span>[</span><span class="ͼk">"items"</span><span>]:</span><br><span>            </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">i</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="ͼm">st</span><span class="ͼg">.</span><span>subheader(</span><span class="ͼk">"Experience"</span><span>)</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">exp</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">data</span><span>[</span><span class="ͼk">"experience"</span><span>]:</span><br><span>        </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"### </span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'company'</span><span>]}</span><span class="ͼk"> | </span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'role'</span><span>]}</span><span class="ͼk">"</span><span>)</span><br><span>        </span><span class="ͼg">for</span><span> </span><span class="ͼm">proj</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">exp</span><span>[</span><span class="ͼk">"projects"</span><span>]:</span><br><span>            </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"**</span><span>{</span><span class="ͼm">proj</span><span>[</span><span class="ͼk">'name'</span><span>]}</span><span class="ͼk">**"</span><span>)</span><br><span>            </span><span class="ͼg">for</span><span> </span><span class="ͼm">d</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">proj</span><span>[</span><span class="ͼk">"details"</span><span>]:</span><br><span>                </span><span class="ͼm">st</span><span class="ͼg">.</span><span>markdown(</span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">d</span><span>}</span><span class="ͼk">"</span><span>)</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
