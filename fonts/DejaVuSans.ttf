<hr data-start="718" data-end="721">
<h1 data-section-id="19kswuf" data-start="723" data-end="756">✅ Apply this in ALL 3 templates</h1>
<h3 data-section-id="1nqdqpb" data-start="758" data-end="767">✔ In:</h3>
<ul data-start="768" data-end="822">
<li data-section-id="gp96ps" data-start="768" data-end="785">
<p data-start="770" data-end="785"><code data-start="770" data-end="785">pdf_classic()</code></p>
</li>
<li data-section-id="fzzuor" data-start="786" data-end="802">
<p data-start="788" data-end="802"><code data-start="788" data-end="802">pdf_modern()</code></p>
</li>
