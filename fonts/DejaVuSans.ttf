" class="-ms-0.5 icon"><use href="/cdn/assets/sprites-core-6d2147a0.svg#6ef7a4" fill="currentColor"></use></svg>Run</div></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="relative"><div class="" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span class="ͼg">def</span><span> </span><span class="ͼm">pdf_modern</span><span>(</span><span class="ͼm">data</span><span>):</span><br><span>    </span><span class="ͼm">pdf</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼm">FPDF</span><span>()</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>add_page()</span><br><br><span>    </span><span class="ͼe"># colored header</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_fill_color(</span><span class="ͼj">40</span><span>, </span><span class="ͼj">80</span><span>, </span><span class="ͼj">120</span><span>)</span><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>rect(</span><span class="ͼj">0</span><span>, </span><span class="ͼj">0</span><span>, </span><span class="ͼj">210</span><span>, </span><span class="ͼj">25</span><span>, </span><span class="ͼk">"F"</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_text_color(</span><span class="ͼj">255</span><span>,</