    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">8</span><span>, </span><span class="ͼk">f"</span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'company'</span><span>]}</span><span class="ͼk"> - </span><span>{</span><span class="ͼm">exp</span><span>[</span><span class="ͼk">'role'</span><span>]}</span><span class="ͼk">"</span><span>, </span><span class="ͼm">ln</span><span class="ͼg">=</span><span class="ͼj">1</span><span>)</span><br><br><span>    </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_font(</span><span class="ͼk">"Arial"</span><span>, </span><span class="ͼm">size</span><span class="ͼg">=</span><span class="ͼj">11</span><span>)</span><br><br><span>    </span><span class="ͼe"># Details</span><br><span>    </span><span class="ͼg">for</span><span> </span><span class="ͼm">detail</span><span> </span><span class="ͼg">in</span><span> </span><span class="ͼm">exp</span><span>[</span><span class="ͼk">"details"</span><span>]:</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>set_x(</span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>l_margin)</span><br><span>        </span><span class="ͼm">wrapped</span><span> </span><span class="ͼg">=</span><span> </span><span class="ͼk">"</span><span class="ͼq">\n</span><span class="ͼk">"</span><span class="ͼg">.</span><span>join(</span><span class="ͼm">textwrap</span><span class="ͼg">.</span><span>wrap(</span><span class="ͼm">detail</span><span>, </span><span class="ͼj">90</span><span>))</span><br><span>        </span><span class="ͼm">pdf</span><span class="ͼg">.</span><span>multi_cell(</span><span class="ͼm">page_width</span><span>, </span><span class="ͼj">7</span><span>, </span><span class="ͼk">f"- </span><span>{</span><span class="ͼm">wrapped</span><span>}</span><span class="ͼk">"</span><span>)</span><br><br><span>    </span><span class="